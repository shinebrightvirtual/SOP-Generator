# Shine Bright SOP Generator — Environment Variables
# Copy this to .env and fill in your keys

# Anthropic API Key (for development only — use serverless functions in production)
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Loom Developer API Key (for fetching video transcripts)
LOOM_API_KEY=

# Deepgram API Key (for transcribing uploaded videos)
DEEPGRAM_API_KEY=

# LemonSqueezy API Key (for payment processing — production only)
LEMONSQUEEZY_API_KEY=
